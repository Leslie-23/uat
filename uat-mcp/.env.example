# Optional settings file for uat-mcp. Copy to .env (same folder) and fill in.
# Only UAT_* keys are read. Never put database URLs or the admin passphrase here.
# Values passed via `claude mcp add --env ...` override these.

UAT_BASE_URL=https://uat-tracker-standalone.vercel.app
# The TESTER passphrase (not the admin one).
UAT_PASSPHRASE=
# UAT_TIMEOUT_MS=15000
# UAT_MAX_IMAGE_BYTES=1500000
